# 复制本文件为 .env 并填入真实值。.env 已被 .gitignore 排除，不会进版本库。
#
#   cp .env.example .env
#
# 已存在的环境变量优先于 .env（override=False），便于 CI 覆盖。

# ---- 火山 ARK：文本生成（模型 minimax-m3）----
# 用途：decision_chain 的更新决策、regeneration_chain 的章节重生成
# 缺失后果：decision_chain 静默降级到规则引擎（只打 warning），
#          regeneration_chain 直接返回 None，相关测试 skip
ARK_API_KEY=

# ---- SiliconFlow：向量化（模型 Qwen/Qwen3-Embedding-8B）----
# 用途：VectorStore 的 embeddings
# 缺失后果：VectorStore 初始化抛 ValueError，Phase 3 全部测试失败
SILICONFLOW_API_KEY=

# ---- GitHub ----
# gh CLI 已通过 gh auth login 配置，通常无需在此设置。
# 仅当需要覆盖 gh 的凭据时才填。
# GH_TOKEN=
